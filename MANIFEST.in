# sdist(ソースの配布物)に、テストと、テストが読むリポジトリのファイルを入れる(展開したもので pytest が通るように)。
# wheel には入らない(パッケージ src/context_foundation の外のものなので)。
# フォルダごと(graft)は入れない: git で無視している手元のファイル(第三者の資料、公開しない計測、.cf の索引、
# 手元の設定)まで入ってしまうため。ファイルの名前か拡張子で入れる。ファイルを足したら、ここにも足す
# (CI の package の job が、sdist の中身と git で追跡しているファイルの食い違いで落ちる)。
include ctxf.py plugin.json mcp.json README.md readme-ja.md CHANGELOG.md LICENSE *.bat
include docs/benchmarks.md docs/comparison-runbook.md docs/copilot.md docs/design.md docs/evaluation-data-spec.md
include bench/README.md bench/agent_run.py bench/answer-format.txt
include examples/o3de/README.md examples/o3de/cases.jsonl examples/o3de/config.example.toml
include skills/context-search/SKILL.md skills/context-search/ctxf.py
include com.github.copilot/hooks/hooks.json
include com.github.copilot/extensions/context-foundation/extension.mjs com.github.copilot/extensions/context-foundation/lib.mjs
include com.github.copilot/extensions/context-foundation/lib.test.mjs
recursive-include .github *.json *.py *.yml
recursive-include tests *.py *.json *.jsonl *.md *.txt *.cpp *.h *.cs
# 拡張子で入れた中にも、手元だけのものが混ざりうる場所は外す
prune bench/runs
prune bench/local
global-exclude .cf/* *.db *.db-* *.partial *.pdf
global-exclude __pycache__ *.py[cod]
