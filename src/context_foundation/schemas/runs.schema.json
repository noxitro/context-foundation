{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noxitro/context-foundation/schemas/runs.schema.json",
  "title": "Run-level metadata (one line of runs.jsonl per run_id)",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "created_at", "corpus_revision", "methods"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 date and time the run started."
    },
    "corpus_revision": {
      "type": "string",
      "description": "Revision of the corpus the line numbers refer to (commit, changelist number, or a dated label)."
    },
    "methods": {
      "type": "object",
      "description": "Method name to its configuration.",
      "additionalProperties": { "type": "object" }
    },
    "candidate_methods": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Methods the decision thresholds apply to, chosen before the run. Other methods are reported for comparison only."
    },
    "corpus": {
      "type": ["object", "null"],
      "description": "Corpus size. Use source aliases only; never absolute paths.",
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 0 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id"],
            "properties": {
              "source_id": { "type": "string" },
              "files": { "type": "integer", "minimum": 0 },
              "lines": { "type": "integer", "minimum": 0 },
              "chunks": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "index": {
      "type": ["object", "null"],
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 0 },
        "build_seconds": { "type": "number", "minimum": 0 },
        "ingest_chunk_seconds": { "type": "number", "minimum": 0 },
        "embed_seconds": { "type": "number", "minimum": 0 },
        "update_seconds": { "type": ["number", "null"], "minimum": 0 },
        "update_mode": {
          "type": "string",
          "description": "full_rebuild until incremental updates exist; then the update cost is the full build time."
        },
        "peak_memory_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "indexed_revision": {
          "type": "string",
          "description": "Corpus revision the index was built from, when it differs from corpus_revision."
        },
        "syntax_fallback_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "embedding": {
      "type": ["object", "null"],
      "properties": {
        "model": { "type": "string" },
        "revision": { "type": "string" },
        "dimensions": { "type": "integer", "minimum": 1 },
        "vector_dtype": {
          "type": "string",
          "description": "Stored precision of the vectors, for example float16."
        }
      }
    },
    "host": {
      "type": ["object", "null"],
      "description": "Machine the run used: operating system, CPU model and core count. No host name or user name."
    },
    "chunking": { "type": ["object", "null"] },
    "agent": {
      "type": ["object", "null"],
      "description": "Agent host used by agent methods.",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "time_limit_seconds": { "type": "number", "minimum": 0 },
        "trials": { "type": "integer", "minimum": 1 },
        "price_per_million_tokens_usd": { "type": ["object", "null"] }
      }
    },
    "thresholds": { "type": ["object", "null"] },
    "data_handling": {
      "type": "string",
      "description": "The data-handling decision for this run, for example: source content stays local."
    },
    "tool_version": { "type": "string" },
    "notes": { "type": "string" }
  }
}
